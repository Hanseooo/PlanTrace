# Names only. Set values in your local .env and in the hosts; never commit them.

# api
DATABASE_URL=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Comma-separated web origins allowed by CORS
CORS_ORIGINS=
# Test database only (D7). pytest reads this and never DATABASE_URL; unset skips DB tests.
TEST_DATABASE_URL=

# web
NEXT_PUBLIC_API_URL=
